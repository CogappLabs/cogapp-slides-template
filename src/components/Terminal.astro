---
interface Props {
  title?: string;
  text: string;
  /** Which side the output sits on. Terminal output normally reads left. */
  align?: "left" | "center" | "right";
  class?: string;
}
const { title = "claude", text, align = "left", class: className = "" } = Astro.props;

const alignClass = {
  left: "text-left",
  center: "text-center",
  right: "text-right",
}[align];
---

{/* Editor-style chrome, so the hex values here are deliberate and sit outside
    the brand palette. Terminal output should look like a terminal. */}
<div class:list={[
  // Scales with the viewport like the rest of the deck: fixed `text-sm` is
  // unreadable from the back of a room.
  "rounded-lg overflow-hidden shadow-xl bg-[#1e1e1e] text-[#d4d4d4] font-mono text-[clamp(1rem,1.5vw,1.35rem)] leading-relaxed w-full",
  className,
]}>
  <div class="flex items-center gap-2 px-3 py-2 bg-[#2d2d2d] border-b border-black/40">
    <span class="w-3 h-3 rounded-full bg-[#ff5f56]" aria-hidden="true"></span>
    <span class="w-3 h-3 rounded-full bg-[#ffbd2e]" aria-hidden="true"></span>
    <span class="w-3 h-3 rounded-full bg-[#27c93f]" aria-hidden="true"></span>
    <span class="ml-3 text-[clamp(0.8rem,1vw,0.95rem)] text-[#969696] select-none">{title}</span>
  </div>
  <pre class:list={["p-4 m-0 whitespace-pre-wrap break-words w-full max-w-full overflow-hidden", alignClass]}>{text}</pre>
</div>
