---
import { getCollection } from "astro:content";
import "../styles/global.css";
import { ClientRouter } from "astro:transitions";
import { slideOrder } from "../content/order";

const all = await getCollection("slides");
const bySlug = new Map(all.map((s) => [s.id, s]));
const ordered = slideOrder.map((slug, i) => {
  const s = bySlug.get(slug);
  if (!s) throw new Error(`Order references missing slide: ${slug}`);
  return { ...s, order: i + 1 };
});
const BASE = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Deck title · Cogapp</title>
    <link rel="icon" type="image/png" href={`${BASE}/favicon.png`} />
    {/* The index is the usual entry point, and `font-display: optional` gives a
        face one shot to arrive. ClientRouter keeps the document alive for the
        whole deck, so missing here means fallback fonts all session. */}
    <link rel="preload" href={`${BASE}/fonts/untitled-serif/untitled-serif-regular.woff2`} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={`${BASE}/fonts/civil/CivilPremium-Regular2.woff2`} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={`${BASE}/fonts/civil/CivilPremium-Medium2.woff2`} as="font" type="font/woff2" crossorigin />
    <ClientRouter />
  </head>
  <body class="bg-cream text-slate m-0">
    <span
      role="img"
      aria-label="Cogapp"
      class="fixed top-5 left-6 block w-[95px] h-[20px] bg-current opacity-70 z-50"
      style={`-webkit-mask:url(${BASE}/cogapp-logo.svg) left center/contain no-repeat;mask:url(${BASE}/cogapp-logo.svg) left center/contain no-repeat;`}
    ></span>

    <main class="max-w-[1100px] mx-auto px-12 min-h-screen flex flex-col justify-center py-[clamp(1.5rem,6vh,5rem)]">
      <header class="mb-[clamp(1.5rem,5vh,4rem)] shrink-0">
        <p class="font-sans font-medium text-sm uppercase tracking-[0.1em] opacity-85 mb-2">
          Subtitle · Context line
        </p>
        <h1 class="font-serif text-[clamp(2.5rem,7vh,5.5rem)] leading-[1.02] tracking-tight mb-[clamp(1rem,3vh,2rem)]">
          Deck title
        </h1>
        <a
          href={`${BASE}/slide/${slideOrder[0]}`}
          data-first-slide={slideOrder[0]}
          class="inline-block font-sans text-lg font-medium text-cream bg-slate border-2 border-slate px-7 py-3 rounded-full no-underline transition-transform hover:-translate-y-0.5"
        >
          Start →
        </a>
      </header>

      <ol class="list-none p-0 m-0 columns-1 md:columns-2 gap-12 shrink-0">
        {ordered.map((s) => (
          <li class="break-inside-avoid">
            <a
              href={`${BASE}/slide/${s.id}`}
              class="grid grid-cols-[2.5em_1fr_auto] gap-4 items-baseline py-[clamp(0.25rem,0.9vh,0.6rem)] text-slate no-underline border-b border-slate/10 transition-colors hover:bg-purple"
            >
              <span class="font-mono text-xs opacity-75 tabular-nums">
                {String(s.order).padStart(2, "0")}
              </span>
              <span class="font-serif text-lg leading-tight">{s.data.title}</span>
              {s.data.section && (
                <span class="font-sans text-xs uppercase tracking-[0.08em] opacity-75">
                  {s.data.section}
                </span>
              )}
            </a>
          </li>
        ))}
      </ol>
    </main>

    <script>
      import { navigate } from "astro:transitions/client";
      const BASE = import.meta.env.BASE_URL.replace(/\/$/, "");
      const FIRST = document.querySelector<HTMLElement>("[data-first-slide]")?.dataset.firstSlide;

      const onKey = (e: KeyboardEvent) => {
        // This module stays alive after a swap to a slide, and page-load fires
        // there too. Without the guard the handler would navigate back to the
        // first slide, beating the slide's own arrow-key handler.
        if (!document.querySelector("[data-first-slide]")) return;
        if (!FIRST) return;
        if (e.metaKey || e.ctrlKey || e.altKey || e.shiftKey) return;
        // Enter is left alone: the links in the index handle it themselves, and
        // taking it over would send a focused link to the first slide instead.
        if (e.key === "ArrowRight" || e.key === "ArrowDown" || e.key === "PageDown") {
          e.preventDefault();
          navigate(`${BASE}/slide/${FIRST}`);
        }
      };
      document.addEventListener("keydown", onKey);
    </script>
  </body>
</html>
