---
import "../styles/global.css";
import { ClientRouter } from "astro:transitions";
import References from "../components/References.astro";
import Eyebrow from "../components/Eyebrow.astro";

const slideAnim = {
  forwards: {
    old: {
      name: "slideOutLeft",
      duration: "0.25s",
      easing: "ease-in",
      fillMode: "forwards",
    },
    new: {
      name: "slideInRight",
      duration: "0.25s",
      easing: "ease-out",
      fillMode: "backwards",
    },
  },
  backwards: {
    old: {
      name: "slideOutRight",
      duration: "0.25s",
      easing: "ease-in",
      fillMode: "forwards",
    },
    new: {
      name: "slideInLeft",
      duration: "0.25s",
      easing: "ease-out",
      fillMode: "backwards",
    },
  },
};

interface Props {
  bg?: "cream" | "slate" | "pink" | "green" | "purple" | "blue" | "white";
  align?: "start" | "center" | "end";
  title: string;
  order: number;
  total: number;
  prev?: string;
  next?: string;
  first: string;
  last: string;
  section?: string;
  eyebrow?: string;
  docs?: string | Array<string | { label: string; href: string }>;
}

type DocLink = { label: string; href: string };
function normaliseDocs(
  d: Props["docs"],
): DocLink[] {
  if (!d) return [];
  const arr = Array.isArray(d) ? d : [d];
  return arr.map((item) => {
    if (typeof item === "string") {
      let label = item;
      try {
        const u = new URL(item);
        label = u.hostname.replace(/^www\./, "") + u.pathname.replace(/\/$/, "");
      } catch {}
      return { label, href: item };
    }
    return item;
  });
}
const {
  bg = "cream",
  align = "start",
  title,
  order,
  total,
  prev,
  next,
  first,
  last,
  section,
  eyebrow,
  docs,
} = Astro.props;
const docLinks = normaliseDocs(docs);
const label = eyebrow ?? section;

const bgClass: Record<string, string> = {
  cream: "bg-cream text-slate",
  slate: "bg-slate text-cream",
  pink: "bg-pink text-slate",
  green: "bg-green text-slate",
  purple: "bg-purple text-slate",
  blue: "bg-blue text-slate",
  white: "bg-white text-slate",
};

const alignClass: Record<string, string> = {
  start: "justify-start",
  center: "justify-center",
  end: "justify-end",
};

const progressPct = total > 1 ? ((order - 1) / (total - 1)) * 100 : 100;

const BASE = import.meta.env.BASE_URL.replace(/\/$/, "");
const homeHref = `${BASE}/`;
const slidePath = (slug: string) => `${BASE}/slide/${slug}`;
---

<!doctype html>
<html lang="en" data-slide-first={first} data-slide-last={last} data-slide-base={BASE}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title} · Cogapp</title>
    <link rel="icon" type="image/png" href={`${BASE}/favicon.png`} />
    <link rel="preload" href={`${BASE}/fonts/untitled-serif/untitled-serif-regular.woff2`} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={`${BASE}/fonts/civil/CivilPremium-Regular2.woff2`} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={`${BASE}/fonts/civil/CivilPremium-Medium2.woff2`} as="font" type="font/woff2" crossorigin />
    <ClientRouter />
  </head>
  <body class={`${bgClass[bg]} m-0 min-h-screen transition-colors duration-300`}>
    <div
      class="fixed top-0 inset-x-0 h-[8px] bg-black/10 z-100"
      role="progressbar"
      aria-label="Presentation progress"
      aria-valuenow={order}
      aria-valuemin={1}
      aria-valuemax={total}
    >
      <div
        class="h-full bg-current opacity-60 transition-[width] duration-500"
        style={`width:${progressPct}%`}
      ></div>
    </div>

    <a
      href={homeHref}
      aria-label="Cogapp"
      class="fixed top-5 left-6 opacity-70 z-50 no-underline text-current hover:opacity-100 transition-opacity"
    >
      <span
        class="block w-[95px] h-[20px] bg-current"
        style={`-webkit-mask:url(${BASE}/cogapp-logo.svg) left center/contain no-repeat;mask:url(${BASE}/cogapp-logo.svg) left center/contain no-repeat;`}
      ></span>
    </a>

    {align === "center" ? (
      <main
        data-slide
        aria-labelledby="slide-title"
        class="min-h-screen px-12 max-w-[1100px] w-full mx-auto flex flex-col justify-center items-start"
        transition:animate={slideAnim}
      >
        <p class="sr-only" id="slide-title">{title}</p>
        {label && <Eyebrow tracking="wide" mb={6}>{label}</Eyebrow>}
        <div class="prose-slide w-full">
          <slot />
          <References links={docLinks} />
        </div>
      </main>
    ) : (
      <main
        data-slide
        aria-labelledby="slide-title"
        class="min-h-screen px-12 max-w-[1100px] w-full mx-auto grid"
        style="grid-template-rows:18vh auto 1fr"
        transition:animate={slideAnim}
      >
        <p class="sr-only" id="slide-title">{title}</p>
        <div></div>
        <header>
          {label && <Eyebrow tracking="wide" mb={6}>{label}</Eyebrow>}
        </header>
        <div class="prose-slide self-start">
          <slot />
          <References links={docLinks} />
        </div>
      </main>
    )}

    <nav
      aria-label="Slide navigation"
      class="fixed bottom-4 right-6 flex gap-1 items-center font-mono text-[0.95rem] text-slate bg-cream/95 backdrop-blur-sm px-2 py-1 rounded shadow-sm z-50"
    >
      {prev !== undefined && (
        <a href={slidePath(prev)} aria-label="Previous slide" rel="prev" class="px-3 py-2 no-underline text-slate"><span aria-hidden="true">←</span></a>
      )}
      <span class="text-slate/70 px-1" aria-label={`Slide ${order} of ${total}`}>
        <span aria-hidden="true">{order}</span><span aria-hidden="true"> / </span><span aria-hidden="true">{total}</span>
      </span>
      {next !== undefined && (
        <a href={slidePath(next)} aria-label="Next slide" rel="next" class="px-3 py-2 no-underline text-slate"><span aria-hidden="true">→</span></a>
      )}
      <button
        type="button"
        data-fullscreen
        aria-label="Enter fullscreen"
        class="px-3 py-2 text-slate bg-transparent border-0 cursor-pointer leading-none"
      >
        <svg aria-hidden="true" width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
          <path data-icon-expand d="M5 1H1v4M9 1h4v4M5 13H1V9M9 13h4V9" />
          <path data-icon-collapse class="hidden" d="M1 5h4V1M13 5H9V1M1 9h4v4M13 9H9v4" />
        </svg>
      </button>
    </nav>

    <script>
      import { navigate } from "astro:transitions/client";

      // Bundled module scripts run once per browser load, not per ClientRouter
      // swap, so these registrations can't stack (addEventListener also dedupes
      // an identical listener). init() re-runs on every astro:page-load to
      // re-sync the button, which the swap replaces with server HTML.
      const init = () => {
        document.addEventListener("keydown", onKey);
        // Capture phase: ClientRouter intercepts link clicks before they bubble,
        // so a bubble-phase listener would set the direction too late.
        document.addEventListener("click", onClick, true);
        document.addEventListener("fullscreenchange", syncFullscreen);
        document.addEventListener("astro:before-preparation", onBeforePreparation);
        syncFullscreen();
      };

      // The button is replaced on every navigation, so query it each time
      // rather than holding a reference.
      const syncFullscreen = () => {
        const btn = document.querySelector("[data-fullscreen]");
        if (!btn) return;
        // The label names the action, so aria-pressed is left off: pairing a
        // changing name with a pressed state reads as a contradiction.
        const on = document.fullscreenElement !== null;
        btn.setAttribute("aria-label", on ? "Exit fullscreen" : "Enter fullscreen");
        btn.querySelector("[data-icon-expand]")?.classList.toggle("hidden", on);
        btn.querySelector("[data-icon-collapse]")?.classList.toggle("hidden", !on);
      };

      // requestFullscreen rejects when the browser blocks it (no user gesture,
      // or an iframe without allowfullscreen). Swallow it so the console stays
      // clean; the icon state is driven by fullscreenchange either way.
      const toggleFullscreen = () => {
        if (document.fullscreenElement) {
          document.exitFullscreen();
        } else {
          document.documentElement.requestFullscreen().catch(() => {});
        }
      };

      // Delegated so it keeps working after a swap replaces the nav.
      const onClick = (e) => {
        if (e.target.closest?.("[data-fullscreen]")) {
          toggleFullscreen();
          return;
        }
        // ClientRouter handles the navigation itself, but it has no idea which
        // way we are going, so the arrows would always animate forwards.
        const link = e.target.closest?.('nav a[rel="prev"], nav a[rel="next"]');
        if (link) setDirection(link.rel === "prev" ? "back" : "forward");
      };

      let pendingDirection = null;
      const setDirection = (dir) => {
        pendingDirection = dir;
      };
      const onBeforePreparation = (e) => {
        if (pendingDirection) {
          e.direction = pendingDirection;
          pendingDirection = null;
        }
      };

      const onKey = (e) => {
        const nav = document.querySelector('nav[aria-label="Slide navigation"]');
        if (!nav) return;
        // Leave every modifier combination to the browser, so Alt+Left still
        // goes back and Cmd/Ctrl+F still opens the find bar.
        if (e.metaKey || e.ctrlKey || e.altKey || e.shiftKey) return;
        // Typing in an island's input should not drive the deck.
        const el = e.target;
        if (el instanceof HTMLElement && (el.isContentEditable || /^(INPUT|TEXTAREA|SELECT)$/.test(el.tagName))) return;
        const prevLink = nav.querySelector('a[rel="prev"]');
        const nextLink = nav.querySelector('a[rel="next"]');
        const first = document.documentElement.dataset.slideFirst;
        const last = document.documentElement.dataset.slideLast;
        const base = document.documentElement.dataset.slideBase || "";

        if (
          e.key === "ArrowRight" ||
          e.key === "ArrowDown" ||
          e.key === "PageDown"
        ) {
          if (nextLink) {
            e.preventDefault();
            setDirection("forward");
            navigate(nextLink.getAttribute("href"));
          }
        } else if (
          e.key === "ArrowLeft" ||
          e.key === "ArrowUp" ||
          e.key === "PageUp"
        ) {
          if (prevLink) {
            e.preventDefault();
            setDirection("back");
            navigate(prevLink.getAttribute("href"));
          }
        } else if (e.key === "Home" && first) {
          // prevLink is absent on the first slide, so this is already there.
          if (!prevLink) return;
          e.preventDefault();
          setDirection("back");
          navigate(`${base}/slide/${first}`);
        } else if (e.key === "End" && last) {
          if (!nextLink) return;
          e.preventDefault();
          setDirection("forward");
          navigate(`${base}/slide/${last}`);
        } else if (e.key === "f" || e.key === "F") {
          e.preventDefault();
          toggleFullscreen();
        }
      };

      document.addEventListener("astro:page-load", init);
      if (document.readyState !== "loading") init();
</script>
  </body>
</html>
